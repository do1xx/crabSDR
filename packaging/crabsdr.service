[Unit]
Description=crabSDR WebSDR
After=network-online.target
Wants=network-online.target

[Service]
User=crabsdr
Group=crabsdr
SupplementaryGroups=plugdev
WorkingDirectory=/opt/crabsdr
Environment=CRABSDR_CONFIG=/etc/crabsdr/config.toml
Environment=RUST_LOG=info
ExecStart=/opt/crabsdr/bin/crabsdr-server
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
# /etc/crabsdr: die Admin-Seite darf die Konfiguration ändern (Datei 640 statt 660 = nur lesen)
ReadWritePaths=/var/lib/crabsdr /etc/crabsdr
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
